# Encrypted blob storage configuration
# The server stores ciphertext only. Encryption stays on the client.

# memory | filesystem | s3
# Auto-detect: S3 credentials → s3; tests → memory; local process → filesystem
# Serverless (Vercel/Lambda/Netlify) does NOT fall back to filesystem.
# BLOB_STORE=s3

# Local/dev filesystem directory (default: .data/blobs)
# Explicit opt-in on serverless (ephemeral, data will be lost):
# BLOB_STORE=filesystem
# BLOB_STORE_DIR=.data/blobs

# Production (required on Vercel): Cloudflare R2 or any S3-compatible store
# S3_BUCKET=secupaste
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_SESSION_TOKEN=

# Expire unused objects with a bucket lifecycle rule on prefix pastes/
# matching this value (R2: bucket settings → object lifecycle rules).
DEFAULT_EXPIRATION_DAYS=30
