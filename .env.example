# Encrypted blob storage configuration
# The server stores ciphertext only. Encryption stays on the client.

# memory | filesystem | s3
# Auto-detect: S3 credentials → s3; tests → memory; otherwise filesystem
# BLOB_STORE=filesystem

# Local/dev filesystem directory (default: .data/blobs)
# BLOB_STORE_DIR=.data/blobs

# Production (free): Cloudflare R2 or any S3-compatible store
# S3_BUCKET=secupaste
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_SESSION_TOKEN=

# Optional Configuration
DEFAULT_EXPIRATION_DAYS=30
